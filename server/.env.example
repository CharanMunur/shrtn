# ==============================================================================
# SPRING BOOT BACKEND ENVIRONMENT CONFIGURATION (`server/.env`)
# ==============================================================================

# Application Server Port
PORT=8080

# Allowed CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://app.shrtn.fun

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://your-db-host.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_postgres_password_here

# Redis Cache Configuration (Upstash TCP Endpoint)
REDIS_HOST=your-redis-name.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password_here

# Mail & Transactional OTP Configuration (Resend API / SMTP)
MAIL_USERNAME=resend
MAIL_PASSWORD=re_123456789_your_resend_api_key

# JWT Authentication Secret Key (Minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_characters_long
