# ==============================================================================
# CLOUDFLARE EDGE REDIRECT WORKER CONFIGURATION (`cloudflare-worker/.env`)
# Used by Wrangler CLI during local development (`bun run dev`) or deployment.
# ==============================================================================

# Upstash Redis REST API (For sub-20ms edge redirects via direct HTTP GET)
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Target Service Origins
APP_DASHBOARD_URL=http://localhost:5173
RENDER_ORIGIN_URL=http://localhost:8080
