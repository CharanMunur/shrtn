# ==============================================================================
# SHRTN MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to `.env` in the project root or relevant subfolders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SPRING BOOT REST API BACKEND SERVICE (`/server`)
# ------------------------------------------------------------------------------

# Application Server Port
PORT=8080

# Allowed CORS Origins (comma-separated origins for web dashboard & dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://app.shrtn.fun

# PostgreSQL Database (Supabase / Render / Managed Postgres)
DB_URL=jdbc:postgresql://your-db-host.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_postgres_password_here

# Redis Cache (Upstash Redis TCP endpoint for Spring Boot connection)
REDIS_HOST=your-redis-name.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password_here

# Mail / OTP Verification Service (Resend API / SMTP)
# For Resend, use username "resend" and password as your API key (re_xxx...)
MAIL_USERNAME=resend
MAIL_PASSWORD=re_123456789_your_resend_api_key

# Security & Authentication (JWT Signing Secret - minimum 256 bits / 32 chars)
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_characters_long


# ------------------------------------------------------------------------------
# 2. REACT 19 DASHBOARD FRONTEND SERVICE (`/client`)
# ------------------------------------------------------------------------------

# Spring Boot REST API Endpoint (Backend URL for API requests)
VITE_API_BASE_URL=http://localhost:8080

# Public Short URL Redirect Base (Base URL prepended to generated short links)
VITE_PUBLIC_SHORT_URL_BASE=http://localhost:8787


# ------------------------------------------------------------------------------
# 3. CLOUDFLARE GO/WASM EDGE REDIRECT WORKER (`/cloudflare-worker`)
# ------------------------------------------------------------------------------

# Upstash Redis REST API (For sub-20ms edge redirects via direct HTTP REST GET)
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Target Service Origins
APP_DASHBOARD_URL=http://localhost:5173
RENDER_ORIGIN_URL=http://localhost:8080
